    tls /etc/letsencrypt/live/olga-pimchenko.ru/fullchain.pem /etc/letsencrypt/live/olga-pimchenko.ru/privkey.pem

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    
