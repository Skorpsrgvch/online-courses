{
    # Замените на ваш реальный email для получения SSL сертификатов Let's Encrypt
    email your@email.com
    
    # Глобальные логи
    log {
        output file /var/log/caddy/access.log {
            roll_size 100MiB
            roll_keep 5
        }
        format json
    }
}

:80 {
    # Маршрутизация API запросов к Go бэкенду
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Все остальные запросы (статика, фронтенд) к Nginx
    handle /* {
        reverse_proxy frontend:80
    }
}