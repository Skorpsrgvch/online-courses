{
    email retro2123@mail.ru
    
    log {
        output file /var/log/caddy/access.log {
            roll_size 100MiB
            roll_keep 5
        }
        format json
    }
}


http://localhost {
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle {
        reverse_proxy frontend:80
    }
}

# В docker-compose нужно будет передать: DOMAIN=mysite.ru
{$DOMAIN:80} {

    # Security Headers для всего сайта
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # API запросы -> Бэкенд
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Всё остальное -> Фронтенд (Nginx)
    handle {
        reverse_proxy frontend:80
    }
}