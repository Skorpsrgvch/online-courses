http://localhost {
    handle /api/* {
        reverse_proxy backend:8080
    }
    handle {
        reverse_proxy frontend:80
    }
}

olga-pimchenko.ru {
    # Security Headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # API запросы -> Бэкенд
    handle /api/* {
        reverse_proxy backend:8080
    }

    # Всё остальное -> Фронтенд
    handle {
        reverse_proxy frontend:80
    }
}